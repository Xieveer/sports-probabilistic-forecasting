# Шаблон переменных окружения. Скопируйте в `.env` и заполните значения.
# Файл `.env` в репозитории не коммитится. См. также: `docs/deploy/secrets.md`.

# --- PostgreSQL (compose `db`, MLflow backend) ---
POSTGRES_PASSWORD=change-me-strong

# --- Production images из CI (.github/workflows/docker.yml) ---
# Подставьте GitHub username/organization (нижний регистр для ghcr).
SF_API_IMAGE=ghcr.io/your-github-user/sports-probabilistic-forecasting-api:latest
SF_WORKER_IMAGE=ghcr.io/your-github-user/sports-probabilistic-forecasting-worker:latest
SF_BOT_IMAGE=ghcr.io/your-github-user/sports-probabilistic-forecasting-telegram-bot:latest

# --- Caddy: публичный домен API (DNS → IP VPS, порты 80/443) ---
SF_API_DOMAIN=api.your-domain.example
# Опционально отдельные хосты для UI (тогда раскомментируйте блоки в deploy/Caddyfile):
# SF_GRAFANA_DOMAIN=grafana.your-domain.example
# SF_MLFLOW_DOMAIN=mlflow.your-domain.example

# --- Grafana ---
GRAFANA_PASSWORD=change-me
GRAFANA_ADMIN_USER=admin
# Публичный URL при доступе через Caddy:
# GRAFANA_ROOT_URL=https://grafana.your-domain.example

# --- Telegram-бот (профиль `bot` в compose; R24 UX вне scope R23) ---
BOT_TOKEN=
BOT_ALLOWED_USER_IDS=
BOT_ADMIN_USER_IDS=
# Внутри compose по умолчанию: http://api:8000
BOT_API_BASE_URL=http://api:8000

# --- The Odds API (ингест коэффициентов NHL и др.; `source_refresh` / cron) ---
ODDS_API_KEY=

# --- Prediction store (хостовый CLI / отладка вне compose) ---
# В docker-compose для api / worker / Airflow строка задаётся явно из POSTGRES_PASSWORD.
# DATABASE_URL=postgresql://sf_user:YOUR_PASSWORD@127.0.0.1:5432/sports_forecast

# --- R39: post-refresh Telegram digest (планируется R39.4–R39.5; parity с worker Airflow) ---
# После внедрения digest те же секреты, что у бота, должны быть в environment контейнеров Airflow
# (LocalExecutor выполняет задачи в scheduler). Включение digest — ожидается как Airflow Variable
# SF_TELEGRAM_DIGEST_ENABLE (см. backlog R39); опциональный override команды — Variable
# SF_POST_REFRESH_DIGEST_CMD. Подробно — docs/source/nhl_local_operations.rst (Prod-like E2E).

# --- MLflow tracking URI (worker / локальный CLI) ---
# В compose worker использует http://mlflow:5000 из docker-compose.yml.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# --- NHL / cron refresh (`python -m sports_forecast.orchestration.cron_refresh`) ---
# SF_PROJECT_DIR=/opt/sports-forecast
# SF_REFRESH_TOURNAMENTS=nhl
# SF_FEATURES_CONFIG=advanced
# SF_MATERIALIZE_MARKET=winner
# SF_MATERIALIZE_SPEC=winner
# SF_REFRESH_LOCK_FILE=/var/lock/sf_refresh_pipeline.lock
# SF_REFRESH_LOCK_WAIT_SECONDS=300

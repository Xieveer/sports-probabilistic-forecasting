# Шаблон переменных окружения. Скопируйте в `.env` и заполните значения.
# Файл `.env` в репозитории не коммитится. См. также: `docs/deploy/secrets.md`.

# --- PostgreSQL (compose `db`) ---
POSTGRES_PASSWORD=change-me-strong
# В Compose используются разные production DB roles: API только читает витрину,
# worker пишет canonical store, execution state и predictions. Их создаёт
# Operations Agent до запуска по отдельному runbook; URL не передаются bot/API image.
SF_API_DATABASE_URL=postgresql://sf_api_reader:change-me@db:5432/sports_forecast
SF_WORKER_DATABASE_URL=postgresql://sf_refresh_writer:change-me@db:5432/sports_forecast

# --- Production images из CI (.github/workflows/docker.yml) ---
# Подставьте GitHub username/organization (нижний регистр для ghcr).
# Для production указывайте полный `image@sha256:digest`, а не tag или `latest`.
SF_API_IMAGE=ghcr.io/your-github-user/sports-probabilistic-forecasting-api@sha256:replace-with-api-digest
SF_WORKER_IMAGE=ghcr.io/your-github-user/sports-probabilistic-forecasting-worker@sha256:replace-with-worker-digest
SF_BOT_IMAGE=ghcr.io/your-github-user/sports-probabilistic-forecasting-telegram-bot@sha256:replace-with-bot-digest
SF_POSTGRES_IMAGE=postgres@sha256:replace-with-postgres-16-alpine-digest
SF_CADDY_IMAGE=caddy@sha256:replace-with-caddy-2-alpine-digest
SF_APP_VERSION=1.1.6
# Scheduler генерирует новый безопасный идентификатор на каждый logical run.
SF_WORKER_RUN_ID=manual-example-20260809

# --- Non-mutating release acceptance (operator-only; не передавать в image) ---
# Адрес read-only DB role: разрешён только SELECT worker_executions для проверки.
SF_ACCEPTANCE_BASE_URL=https://api.your-domain.example
SF_ACCEPTANCE_PREDICTION_PATH=/predict/KNOWN_MATCH_ID?market=winner_withOT&market_spec=winner_withOT&live_pinnacle=false
SF_ACCEPTANCE_MODEL_VERSION=approved-model-bundle-id
SF_ACCEPTANCE_DATABASE_URL=postgresql://sf_acceptance_reader:YOUR_PASSWORD@127.0.0.1:5432/sports_forecast
SF_ACCEPTANCE_WORKER_RUN_ID=daily-YYYYMMDD
# Выполняется на host с Docker; команда читает только healthcheck bot.
SF_ACCEPTANCE_BOT_HEALTH_COMMAND=docker compose -f docker-compose.prod.yml exec -T telegram-bot uv run python -m sports_forecast.bot.heartbeat --path /tmp/sf-bot-heartbeat.json --max-age-seconds 120

# --- Caddy: публичный домен API (DNS → IP VPS, порты 80/443) ---
SF_API_DOMAIN=api.your-domain.example
# --- Telegram-бот ---
BOT_TOKEN=
BOT_ALLOWED_USER_IDS=
BOT_ADMIN_USER_IDS=
# Один chat ID только для явной проверки первой доставки после rollout.
SF_DELIVERY_VERIFICATION_CHAT_ID=
# Внутри compose по умолчанию: http://api:8000
BOT_API_BASE_URL=http://api:8000

# --- The Odds API (ключи хранятся только в .env/secret store) ---
# Порядок расходования: бесплатная квота → тариф 20k → тариф 100k.
ODDS_API_KEY_FREE=
ODDS_API_KEY_20K=
ODDS_API_KEY_100K=
# Временный fallback для старого контура; не задавайте одновременно с тремя ключами выше.
ODDS_API_KEY=

# --- Prediction store (хостовый CLI / отладка вне compose) ---
# В production Compose строка задаётся явно из POSTGRES_PASSWORD.
# DATABASE_URL=postgresql://sf_user:YOUR_PASSWORD@127.0.0.1:5432/sports_forecast

# --- Yandex Object Storage: operational archive и compact serving-data ---
# VPS: write только в SF_OPERATIONAL_ARCHIVE_PREFIX, read только в SF_SERVING_DATA_PREFIX.
# Локальный DVC remote использует отдельный prefix и не смешивается с archive.
SF_OBJECT_STORAGE_ENDPOINT=
SF_OBJECT_STORAGE_BUCKET=
SF_OBJECT_STORAGE_ACCESS_KEY_ID=
SF_OBJECT_STORAGE_SECRET_ACCESS_KEY=
SF_OPERATIONAL_ARCHIVE_PREFIX=operational-archive
SF_NHL_SOURCE_STATE_PREFIX=operational-archive/nhl-source-state/v1
SF_SERVING_DATA_PREFIX=serving-data-bundles

# --- Canonical refresh runtime (только systemd refresh profile) ---
# Worker читает provider snapshot только read-only и пишет snapshot сначала в
# локальный persistent staging. Отдельный Operations sync имеет S3 write только
# к operational-archive; runtime-container не получает Object Storage credential.
SF_MODEL_RUNTIME_ROOT=/srv/sports-forecast/runtime_models
SF_CANONICAL_SOURCE_ROOT=/srv/sports-forecast/source/nhl
SF_OPERATIONAL_ARCHIVE_ROOT=/srv/sports-forecast/archive-staging
# Persistent retry state отдельного sync process (не mount Worker).
SF_ARCHIVE_SYNC_STATE_ROOT=/srv/sports-forecast/archive-sync-state
# Immutable image отдельного sync process c boto3; не равен SF_WORKER_IMAGE.
SF_ARCHIVE_SYNC_IMAGE=

# --- MLflow (только локальный training-контур) ---
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# --- NHL / cron refresh (`python -m sports_forecast.orchestration.cron_refresh`) ---
# SF_PROJECT_DIR=/opt/sports-forecast
# SF_REFRESH_TOURNAMENTS=nhl
# SF_FEATURES_CONFIG=advanced
# SF_MATERIALIZE_MARKET=winner
# SF_MATERIALIZE_SPEC=winner
# SF_REFRESH_LOCK_FILE=/var/lock/sf_refresh_pipeline.lock
# SF_REFRESH_LOCK_WAIT_SECONDS=300

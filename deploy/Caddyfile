# Reverse proxy + автоматический HTTPS (Let's Encrypt) для production.
#
# Обязательно: DNS A/AAAA записи SF_API_DOMAIN → IP VPS; порты 80/443 открыты.
# Метрики API собирает Grafana Alloy по внутренней сети. Публичный ingress их
# намеренно не проксирует.

{$SF_API_DOMAIN} {
    encode gzip zstd
    @internal_metrics path /metrics /metrics/*
    respond @internal_metrics 404
    reverse_proxy api:8000
}

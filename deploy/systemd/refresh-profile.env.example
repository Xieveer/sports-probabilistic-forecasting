# Установите как /etc/sports-forecast/refresh/<profile>.env, режим 0600 root:root.
# Значения credential не коммитятся. Profile определяет tournament и Hydra выбор,
# а timer drop-in определяет cadence и timeout.
SF_TOURNAMENT=nhl
SF_MARKET=winner_withOT
SF_MARKET_SPEC=winner_withOT
SF_ALGORITHM=catboost
SF_FEATURES=basic
SF_WORKER_DATABASE_URL_FILE=/etc/sports-forecast/secrets/worker_database_url
# Compose validates all service interpolations before starting only the worker;
# API получает URL только в собственном container environment.
SF_API_DATABASE_URL_FILE=/etc/sports-forecast/secrets/api_database_url
SF_MIGRATOR_DATABASE_URL_FILE=/etc/sports-forecast/secrets/migrator_database_url
SF_POSTGRES_PASSWORD_FILE=/etc/sports-forecast/secrets/postgres_password
SF_API_DB_PASSWORD_FILE=/etc/sports-forecast/secrets/api_db_password
SF_WORKER_DB_PASSWORD_FILE=/etc/sports-forecast/secrets/worker_db_password
SF_MIGRATOR_DB_PASSWORD_FILE=/etc/sports-forecast/secrets/migrator_db_password
SF_BOT_TOKEN_FILE=/etc/sports-forecast/secrets/bot_token
ODDS_API_KEY_FREE_FILE=/etc/sports-forecast/secrets/odds_api_key_free
ODDS_API_KEY_20K_FILE=/etc/sports-forecast/secrets/odds_api_key_20k
ODDS_API_KEY_100K_FILE=/etc/sports-forecast/secrets/odds_api_key_100k
ODDS_API_KEY_FILE=/etc/sports-forecast/secrets/odds_api_key
SF_OBJECT_STORAGE_ACCESS_KEY_ID_FILE=/etc/sports-forecast/secrets/object_storage_access_key
SF_OBJECT_STORAGE_SECRET_ACCESS_KEY_FILE=/etc/sports-forecast/secrets/object_storage_secret_key
SF_APP_VERSION=1.1.9
SF_MODEL_RUNTIME_ROOT=/srv/sports-forecast/runtime_models
SF_CANONICAL_SOURCE_ROOT=/srv/sports-forecast/source/nhl
SF_OPERATIONAL_ARCHIVE_ROOT=/srv/sports-forecast/archive-staging
SF_ARCHIVE_SYNC_STATE_ROOT=/srv/sports-forecast/archive-sync-state
SF_WORKER_IMAGE=ghcr.io/example/sports-forecast-worker@sha256:CHANGE_ME
SF_API_IMAGE=ghcr.io/example/sports-forecast-api@sha256:CHANGE_ME
SF_BOT_IMAGE=ghcr.io/example/sports-forecast-bot@sha256:CHANGE_ME
SF_POSTGRES_IMAGE=postgres@sha256:CHANGE_ME
SF_ARCHIVE_SYNC_IMAGE=ghcr.io/example/sports-forecast-archive-sync@sha256:CHANGE_ME
SF_CADDY_IMAGE=caddy@sha256:CHANGE_ME
SF_WORKER_RUN_ID=provided-by-run-canonical-refresh
SF_OBJECT_STORAGE_ENDPOINT=https://storage.example.invalid
SF_OBJECT_STORAGE_BUCKET=replace-with-production-bucket
SF_API_DOMAIN=api.example.invalid

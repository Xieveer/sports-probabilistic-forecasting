# Установите как /etc/sports-forecast/refresh/<profile>.env, режим 0600 root:root.
# Значения credential не коммитятся. Profile определяет tournament и Hydra выбор,
# а timer drop-in определяет cadence и timeout.
SF_TOURNAMENT=nhl
SF_MARKET=winner_withOT
SF_MARKET_SPEC=winner_withOT
SF_ALGORITHM=catboost
SF_FEATURES=basic
SF_WORKER_DATABASE_URL=postgresql://sf_refresh_writer:CHANGE_ME@db:5432/sports_forecast
# Compose validates all service interpolations before starting only the worker;
# API получает URL только в собственном container environment.
SF_API_DATABASE_URL=postgresql://sf_api_reader:CHANGE_ME@db:5432/sports_forecast
SF_APP_VERSION=1.1.4
SF_CANONICAL_SOURCE_ROOT=/srv/sports-forecast/source/nhl
SF_OPERATIONAL_ARCHIVE_ROOT=/srv/sports-forecast/archive-staging
SF_WORKER_IMAGE=ghcr.io/example/sports-forecast-worker@sha256:CHANGE_ME
SF_API_IMAGE=ghcr.io/example/sports-forecast-api@sha256:CHANGE_ME
SF_BOT_IMAGE=ghcr.io/example/sports-forecast-bot@sha256:CHANGE_ME
SF_POSTGRES_IMAGE=postgres@sha256:CHANGE_ME
SF_CADDY_IMAGE=caddy@sha256:CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
SF_API_DOMAIN=api.example.invalid

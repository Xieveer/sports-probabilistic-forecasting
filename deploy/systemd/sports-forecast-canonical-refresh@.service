[Unit]
Description=Sports Forecast canonical full refresh (%i)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=/opt/sports-forecast
EnvironmentFile=/etc/sports-forecast/refresh/%i.env
TimeoutStartSec=90m
Restart=on-failure
RestartSec=5m
ExecStart=/opt/sports-forecast/deploy/systemd/dispatch-data-cycle.sh %i

[Install]
WantedBy=multi-user.target
